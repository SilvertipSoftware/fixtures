{
    "name": "silvertipsoftware/fixtures",
    "description": "A better fixture package for Laravel",
    "keywords": ["laravel", "fixtures"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Silvertip Software",
            "email": "info@silvertipsoftware.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^9.0",
        "illuminate/database": "^9.0",
        "illuminate/filesystem": "^9.0",
        "symfony/yaml": "^6.0",
        "ramsey/uuid": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.5"
    },
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "SilvertipSoftware\\Fixtures\\": "src/Fixtures/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests/StubTestCase.php"
        ]
    }
}
